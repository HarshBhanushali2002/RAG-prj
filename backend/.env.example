# ============================================================
# RAG Document Q&A — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Get your FREE Gemini API key at:
#   https://aistudio.google.com/apikey
# ============================================================

# Your Google Gemini API key (required)
GOOGLE_API_KEY=your-gemini-api-key-here

# LLM model to use for generating answers
# Options: gemini-2.0-flash (fast, free), gemini-2.5-pro (best quality)
LLM_MODEL=gemini-2.0-flash

# Embedding model for converting text → vectors
# text-embedding-004 is Google's latest, 768-dimensional
EMBEDDING_MODEL=text-embedding-004

# ChromaDB storage location (relative to backend/)
CHROMA_DB_PATH=./chroma_db

# Upload directory for PDFs
UPLOAD_DIR=./uploads

# ============================================================
# CHUNKING SETTINGS — Experiment with these!
# ============================================================
# Chunk size in characters (try 500, 1000, 2000 and compare results)
CHUNK_SIZE=1000

# Overlap between chunks (prevents cutting sentences in half)
CHUNK_OVERLAP=200

# Number of similar chunks to retrieve per query
TOP_K=5
